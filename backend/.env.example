# Copy this file to .env and fill in real values before running the app.
# Never commit real secrets — see docs/API_CONTRACT.md re: GitLab rules.

# --- Local Postgres (default) ---
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/condo_argo

# --- Supabase (production / Vercel) ---
# Get this from Supabase → Project Settings → Database → Connection string →
# "Transaction" pooler (port 6543). Use the pooler, not the direct :5432
# connection — serverless functions open/close connections per request and
# will exhaust Supabase's direct connection limit otherwise.
# Must keep the "+psycopg2" driver marker and "?sslmode=require" suffix.
# DATABASE_URL=postgresql+psycopg2://postgres.xxxxxxxxxxxx:your_password@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

JWT_SECRET_KEY=replace-with-a-long-random-secret-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=240
# Comma-separated list of allowed frontend origins for CORS, e.g.
# CORS_ORIGINS=https://condo-argo-frontend.vercel.app,http://localhost:5173
CORS_ORIGINS=*
